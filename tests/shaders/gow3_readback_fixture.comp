#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform texture2DMS depth_image;
layout(binding=1) uniform texture2DMS srgb_image;
layout(binding=2) uniform texture2DMS unorm_image;
struct Sample { vec4 linear_color; vec4 encoded_color; uvec4 identity; vec4 depth_pixel; };
layout(binding=3,std430) writeonly buffer Output { Sample samples[]; } result;
layout(push_constant) uniform Token { uvec4 value; } token;
void main() {
    uvec2 pixel=gl_GlobalInvocationID.xy;
    if(pixel.x>=64 || pixel.y>=48) return;
    for(uint s=0;s<2;++s) {
        uint i=(pixel.y*64+pixel.x)*2+s;
        result.samples[i].linear_color=texelFetch(srgb_image,ivec2(pixel),int(s));
        result.samples[i].encoded_color=texelFetch(unorm_image,ivec2(pixel),int(s));
        result.samples[i].identity=uvec4(token.value.xyz,s);
        result.samples[i].depth_pixel=vec4(texelFetch(depth_image,ivec2(pixel),int(s)).r,vec2(pixel),1);
    }
}
