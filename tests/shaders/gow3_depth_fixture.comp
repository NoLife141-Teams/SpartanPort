// Test-only VP consumer. Never used by the game's legacy camera_motion.comp.
#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8, local_size_y=8) in;
#if SAMPLES == 2
layout(binding=0) uniform texture2DMS depth_image;
layout(binding=1) uniform texture2DMS metadata_image;
#else
layout(binding=0) uniform texture2D depth_image;
layout(binding=1) uniform texture2D metadata_image;
#endif
struct Sample { vec4 depth_position_id; vec4 motion_valid_fragment_depth; };
layout(binding=2, std430) writeonly buffer Output { Sample samples[]; } result;
layout(push_constant) uniform Matrices { mat4 inverse_current; mat4 previous; } pc;
layout(constant_id=0) const bool original_minus_depth=false;
layout(constant_id=1) const bool negative_viewport=true;
layout(constant_id=2) const float min_depth=0;
layout(constant_id=3) const float max_depth=1;
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x>=64 || pixel.y>=48) return;
    for (int s=0; s<SAMPLES; ++s) {
        float depth=texelFetch(depth_image,pixel,s).r;
        vec4 metadata=texelFetch(metadata_image,pixel,s);
        vec2 location=vec2(pixel)+metadata.xy;
        float unit_depth=(depth-min_depth)/(max_depth-min_depth);
        float clip_depth=original_minus_depth?2*unit_depth-1:unit_depth;
        float ndc_y=negative_viewport?1-location.y/48*2:location.y/48*2-1;
        vec4 world=pc.inverse_current*vec4(location.x/64*2-1,ndc_y,clip_depth,1);
        vec4 clip=pc.previous*world;
        vec3 ndc=clip.xyz/clip.w;
        bool valid=depth>=0 && depth<1 && clip.w>1e-8 &&
                   !any(isnan(ndc)) && !any(isinf(ndc)) &&
                   all(lessThanEqual(abs(ndc.xy),vec2(1))) &&
                   ndc.z>=(original_minus_depth?-1:0) && ndc.z<=1;
        vec2 previous=vec2((ndc.x+1)*32,(negative_viewport?1-ndc.y:1+ndc.y)*24);
        uint index=(uint(pixel.y)*64+uint(pixel.x))*SAMPLES+s;
        result.samples[index].depth_position_id=vec4(depth,metadata.xy,metadata.w);
        result.samples[index].motion_valid_fragment_depth=vec4(valid ? previous-location : vec2(0),
                                                             valid ? 1 : 0,metadata.z);
    }
}
