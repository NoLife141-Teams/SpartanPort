#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform texture2D filtered_color;
#if defined(NR_FUSED) && !defined(SINGLE_SAMPLE)
layout(binding=1) uniform texture2DMS original_color;
#else
layout(binding=1) uniform texture2D original_color;
#endif
#ifdef SINGLE_SAMPLE
layout(binding=2,rgba16f) writeonly uniform image2D multisample_out;
#else
layout(binding=2,rgba16f) writeonly uniform image2DMS multisample_out;
#endif
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),sz=imageSize(multisample_out);
    if(any(greaterThanEqual(p,sz))) return;
    vec4 c=texelFetch(filtered_color,p,0);
#ifdef NR_FUSED
    vec3 v=clamp(c.rgb,0,1);
    c.rgb=mix(pow((v+.055)/1.055,vec3(2.4)),v/12.92,lessThanEqual(v,vec3(.04045)));
#ifndef SINGLE_SAMPLE
    c.a=(texelFetch(original_color,p,0).a+texelFetch(original_color,p,1).a)*.5;
#else
    c.a=texelFetch(original_color,p,0).a;
#endif
#else
    c.a=texelFetch(original_color,p,0).a;
#endif
#ifdef SINGLE_SAMPLE
    imageStore(multisample_out,p,c);
#else
    imageStore(multisample_out,p,0,c);
    imageStore(multisample_out,p,1,c);
#endif
}
