// Diagnostic-only synchronized previews of the same completed NGX frame.
#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0,rgba16f) readonly uniform image2D neutral;
layout(binding=1,rgba16f) readonly uniform image2D low;
layout(binding=2,rgba16f) readonly uniform image2D medium;
layout(std430,binding=3) writeonly buffer Output { uint pixels[]; } result;
vec3 srgb(vec3 c) {
    c=clamp(c,0,1);
    return mix(1.055*pow(c,vec3(1.0/2.4))-.055,12.92*c,lessThanEqual(c,vec3(.0031308)));
}
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),sz=imageSize(neutral)/2;
    if(any(greaterThanEqual(p,sz))) return;
    vec3 a=vec3(0),b=vec3(0),c=vec3(0);
    for(int y=0;y<2;++y) for(int x=0;x<2;++x) {
        ivec2 q=p*2+ivec2(x,y);
        a+=imageLoad(neutral,q).rgb;b+=imageLoad(low,q).rgb;c+=imageLoad(medium,q).rgb;
    }
    uint n=uint(p.y*sz.x+p.x),stride=uint(sz.x*sz.y);
    result.pixels[n]=packUnorm4x8(vec4(srgb(a*.25),1));
    result.pixels[n+stride]=packUnorm4x8(vec4(srgb(b*.25),1));
    result.pixels[n+stride*2]=packUnorm4x8(vec4(srgb(c*.25),1));
}
