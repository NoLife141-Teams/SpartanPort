#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8,local_size_y=8) in;
#ifdef SINGLE_SAMPLE
#define SceneTexture texture2D
#else
#define SceneTexture texture2DMS
#endif
layout(binding=0) uniform SceneTexture scene_depth;
layout(binding=1) uniform SceneTexture scene_color;
layout(binding=2) uniform SceneTexture object_motion;
layout(binding=3,rgba16f) writeonly uniform image2D color_out;
layout(binding=4,r32f) writeonly uniform image2D depth_out;
layout(binding=5,rg16f) writeonly uniform image2D motion_out;
#ifdef NR_GUIDES
layout(binding=6,rgba32f) writeonly uniform image2D guide_diagnostic;
#endif
layout(push_constant) uniform Params { mat4 reprojection; vec2 raster_jitter; uint camera_valid; } pc;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy), sz=imageSize(color_out);
    if(any(greaterThanEqual(p,sz))) return;
    float d0=texelFetch(scene_depth,p,0).r;
#ifdef SINGLE_SAMPLE
    float d1=d0;
#else
    float d1=texelFetch(scene_depth,p,1).r;
#endif
    int s=d1<d0?1:0;
    float d=min(d0,d1);
    vec2 current=vec2(p)+.5-pc.raster_jitter, flow=vec2(0);
    vec4 prev=pc.reprojection*vec4(2*current.x/sz.x-1,1-2*current.y/sz.y,2*d-1,1);
    if(pc.camera_valid!=0 && d<1 && prev.w>1e-5) {
        vec2 ndc=prev.xy/prev.w;
        flow=vec2((ndc.x+1)*.5*sz.x,(1-ndc.y)*.5*sz.y)-current;
    }
    vec4 m=texelFetch(object_motion,p,s);
    bool object_valid=m.z>.999 && abs(m.w-d)<=2e-7 && all(lessThan(abs(m.xy),vec2(sz)));
#ifdef NR_GUIDES
    imageStore(guide_diagnostic,p,vec4(object_valid?(m.z>1.5?2:1):0,m.w,flow));
#endif
    if(object_valid) flow=m.xy;
    if(any(isnan(flow))||any(isinf(flow))) flow=vec2(0);
#ifdef SINGLE_SAMPLE
    imageStore(color_out,p,texelFetch(scene_color,p,0));
#else
    imageStore(color_out,p,(texelFetch(scene_color,p,0)+texelFetch(scene_color,p,1))*.5);
#endif
    imageStore(depth_out,p,vec4(d));
    imageStore(motion_out,p,vec4(flow,0,0));
}
